[sub_resource type="GDScript" id="GDScript_yx7mw"]
script/source = "@tool # Allows you to see the circle inside the editor
extends Line2D

@export var radius: float = 100.0:
	set(value):
		radius = value
		queue_redraw()

@export var point_count: int = 64: # Higher numbers mean a smoother circle
	set(value):
		point_count = max(3, value) # A circle needs at least 3 points
		queue_redraw()

func _draw() -> void:
	var circle_points = PackedVector2Array()
	
	for i in range(point_count + 1):
		# Calculate the angle for each point around the circle
		var angle = (i * TAU) / point_count
		# Convert the angle to a position vector and scale by the radius
		var point_position = Vector2(cos(angle), sin(angle)) * radius
		circle_points.append(point_position)
		
	points = circle_points
"

